# Install as /etc/paper-research-agent/paper-research-agent.env with mode 600.
# Never place real values in Git or in the deployment bundle.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRA_CORPUS_DIR=/srv/paper-research-agent/current/corpus
PRA_WEB_SESSION_SECRET=
PRA_ALLOWED_ORIGINS=https://zhimoai.online,https://www.zhimoai.online
PRA_WEB_COOKIE_SECURE=true
PRA_WEB_SESSION_TTL_SECONDS=43200
PRA_WEB_MAX_QUESTION_CHARS=2000
PRA_RESEARCH_AGENT_ENABLED=false
PRA_RESEARCH_AGENT_MAX_STEPS=2
PRA_RESEARCH_AGENT_EVIDENCE_PER_STEP=3
PRA_RESEARCH_AGENT_MAX_TOOL_CALLS=4
PRA_RESEARCH_AGENT_TIMEOUT_SECONDS=90
