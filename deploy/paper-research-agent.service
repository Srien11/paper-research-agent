[Unit]
Description=Private Paper Research Agent Web Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=paper-rag
Group=paper-rag
WorkingDirectory=/srv/paper-research-agent/current
Environment=PYTHONPATH=/srv/paper-research-agent/current/src
Environment=PYTHONUNBUFFERED=1
Environment=FASTEMBED_CACHE_PATH=/srv/paper-research-agent/model-cache
# Reuse the existing owner's PBKDF2 login variables without copying credentials.
EnvironmentFile=-/etc/zhimo-site-admin.env
EnvironmentFile=/etc/paper-research-agent/paper-research-agent.env
ExecStart=/srv/paper-research-agent/current/.venv/bin/python scripts/serve_web.py --host 127.0.0.1 --port 8092
Restart=on-failure
RestartSec=10s
TimeoutStartSec=180s
TimeoutStopSec=45s
KillSignal=SIGINT
UMask=0077

# Keep this optional research service from starving the public site on a 2-core,
# 1.8 GiB host. If the models ever outgrow the budget, only this unit fails.
CPUQuota=150%
CPUWeight=50
MemoryHigh=700M
MemoryMax=850M
MemorySwapMax=0
OOMPolicy=stop
OOMScoreAdjust=500
TasksMax=128

# The model/index bundle is immutable; only runtime SQLite files are writable.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/paper-research-agent/current/data/runtime /srv/paper-research-agent/model-cache

[Install]
WantedBy=multi-user.target
