PRA_CORPUS_DIR=D:\path\to\research_collection
PRA_REQUIRE_LOCAL_PDFS=true
PRA_LOG_LEVEL=INFO
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Owner-only Web interface. Never commit real values.
PRA_WEB_USER=owner
# Leave blank when reusing ZHIMO_ADMIN_SALT/ZHIMO_ADMIN_HASH on the server.
PRA_WEB_PASSWORD=
PRA_WEB_SESSION_SECRET=
PRA_ALLOWED_ORIGINS=https://zhimoai.online,https://www.zhimoai.online
PRA_WEB_COOKIE_SECURE=true
PRA_WEB_SESSION_TTL_SECONDS=43200
PRA_WEB_MAX_QUESTION_CHARS=2000

# 主 Agent 统一入口灰度开关（false 时保留旧路由路径）。
PRA_MAIN_AGENT_ENABLED=false
