PRA_CORPUS_DIR=D:\path\to\research_collection
PRA_REQUIRE_LOCAL_PDFS=true
PRA_LOG_LEVEL=INFO
# 扫描 PDF 降级：默认开启，仅在含栅格图像且文本层不足时调用。
PRA_OCR_ENABLED=true
PRA_TESSERACT_CMD=tesseract
PRA_OCR_LANGUAGES=eng+chi_sim
PRA_OCR_DPI=300
PRA_OCR_TIMEOUT_SECONDS=120
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ragas（RAG 评测框架）使用独立裁判配置。Key 留空时回退到 DASHSCOPE_API_KEY。
PRA_RAGAS_API_KEY=
PRA_RAGAS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRA_RAGAS_JUDGE_MODEL=qwen3.7-plus-2026-05-26
PRA_RAGAS_EMBEDDING_MODEL=text-embedding-v4

# 本机 16 逻辑线程配置：最多六个独立比较检索并发；每个本地数值库任务限制为 2 个底层线程。
# 完整 RAG 请求仍保持单通道，避免两个大问题同时挤占模型和索引内存。
PRA_LOCAL_RETRIEVAL_WORKERS=4
PRA_COMPARISON_SEARCH_CONCURRENCY=4
PRA_RESEARCH_AGENT_EVIDENCE_PER_STEP=4
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Owner-only Web interface. Never commit real values.
PRA_WEB_USER=owner
# 本机可直接填写密码；也可留空并自行提供兼容的哈希凭据。
PRA_WEB_PASSWORD=
PRA_WEB_SESSION_SECRET=
PRA_ALLOWED_ORIGINS=http://127.0.0.1:8092,http://localhost:8092
PRA_WEB_COOKIE_SECURE=false
PRA_WEB_SESSION_TTL_SECONDS=43200
PRA_WEB_MAX_QUESTION_CHARS=2000
# 同一会话保持串行；不同会话最多同时执行 2 个问答。设为 1 可回退为全局串行。
PRA_WEB_MAX_INFLIGHT_RUNS=2

# 主 Agent 本机统一入口。serve_web.py 未显式配置时也默认 primary。
# 本机排障时可临时改为 legacy 并重启；不要同时配置已废弃的 ENABLED 开关。
PRA_MAIN_AGENT_MODE=primary
PRA_MAIN_AGENT_MODEL=qwen3.7-plus-2026-05-26
PRA_MAIN_AGENT_TIMEOUT_SECONDS=180
PRA_MAIN_AGENT_MAX_INFLIGHT_RUNS=2
PRA_MAIN_AGENT_FAST_PATH_ENABLED=true
PRA_PARALLEL_HYBRID_RESEARCH_ENABLED=true
PRA_MAIN_AGENT_CHECKPOINT_PATH=data/runtime/main-agent-state-v1.sqlite3

# 学术元数据 Provider（提供方）默认完全离线，不创建 HTTP 客户端。
# 未来完成真实接入并显式授权联网后，才改为 live 并填写本机 Key。
PRA_SCHOLARLY_MODE=offline
SEMANTIC_SCHOLAR_API_KEY=
PRA_MCP_ENABLED=false
PRA_MCP_CONFIG_PATH=deploy/mcp-servers.json
PRA_CONVERSATION_PATH=data/runtime/conversation-v1.sqlite3
PRA_ATTACHMENT_PATH=data/runtime/uploads
